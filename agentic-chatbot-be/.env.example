# Copy this file to .env and fill in the values for whichever real
# integrations you want to enable. Everything runs in offline/mock mode
# with NO keys at all -- LLM_PROVIDER=mock, offline ChromaDB knowledge base.
#
# Not present in this build (see README "What's WIP"): Pinecone,
# Tavily web search, MCP transport.

# Which LLM provider to use: "gemini" | "openai" | "anthropic" | "mock"
LLM_PROVIDER=mock

# Google Gemini -- the dissertation's primary chosen model (2.5 Flash)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# OpenAI-compatible (also works for Groq/Llama-family endpoints via OPENAI_BASE_URL)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Where the LangGraph agent (api/main.py) finds the Fulfillment API service
FULFILLMENT_API_URL=http://localhost:8010

# Voice (speech-to-text + text-to-speech). Get a key at https://console.deepgram.com
# and paste it here in your own .env -- leave blank to run without voice.
DEEPGRAM_API_KEY=
